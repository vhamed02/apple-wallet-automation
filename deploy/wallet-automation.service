[Unit]
Description=Apple Wallet Automation
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/apple-wallet-automation
ExecStart=/var/www/apple-wallet-automation/wallet-automation
Restart=always
RestartSec=5
Environment=PORT=3000
Environment=GOTOOLCHAIN=local
Environment=CONFIG_PATH=/var/www/apple-wallet-automation/config.yml
Environment=CREDENTIALS_PATH=/var/www/apple-wallet-automation/credentials.yml

[Install]
WantedBy=multi-user.target
